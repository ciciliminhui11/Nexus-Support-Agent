# ===================== 环境变量模板 =====================
# 复制本文件为 `.env` 并填写真实值。真实密钥禁止提交仓库。
# 各配置项说明见 app/config.py 与 specs/*/contracts/* 的「配置契约」章节。

# ---------- 数据库（必填） ----------
# MySQL 8.0，连接串格式：mysql+pymysql://<user>:<password>@<host>:<port>/<db>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/nexus_support?charset=utf8mb4

# ---------- 003 鉴权（JWT 必填） ----------
# JWT 签名密钥，生产环境必填且 ≥32 字节随机串
JWT_SECRET=please-change-me-to-a-random-secret-at-least-32-bytes
JWT_EXPIRE_HOURS=24
MIN_PASSWORD_LENGTH=8
# 手机号注册格式校验（正则，默认中国大陆手机号）
PHONE_REGEX=^1[3-9]\d{9}$
# 登录失败锁定：连续失败阈值与锁定秒数
LOGIN_FAIL_THRESHOLD=5
LOGIN_LOCK_MAX_SECONDS=300
# 每日问答配额
DAILY_QUOTA_LIMIT=100
# 预置管理员账号标识（启动时置 admin 角色）
ADMIN_ACCOUNT=admin
# 仅开发预置用默认密码，生产必须修改
ADMIN_PASSWORD=admin123456

# ---------- LLM / Embedding ----------
# 向量库本地目录
CHROMA_DIR=./chroma_data
# 对话 LLM 后端：deepseek（OpenAI 兼容 API，默认）| ollama（本地）
LLM_BACKEND=deepseek
# LLM 统一配置（001 对话 + 006 意图兜底共用）
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
# DeepSeek API 密钥（001 对话 + 006 意图识别共用）
DEEPSEEK_API_KEY=
# embedding 后端：openai_compat（OpenAI 兼容云端 API，如 SiliconFlow 免费 bge-m3）
#            | local（本地 sentence-transformers，需装 sentence-transformers + torch）
#            | ollama（经 Ollama 提供 bge-m3，需本机运行 Ollama 服务）
EMBEDDING_BACKEND=openai_compat
# 仅 EMBEDDING_BACKEND=openai_compat 时生效
EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=BAAI/bge-m3
# 仅 EMBEDDING_BACKEND=local 时生效（本地 bge-m3 模型名）
LOCAL_EMBED_MODEL=BAAI/bge-m3
# 仅 EMBEDDING_BACKEND=ollama 时生效
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
# 仅 LLM_BACKEND=ollama 时生效（本地对话模型）
OLLAMA_CHAT_MODEL=qwen2

# ---------- 001 RAG 混合检索 / 精排 / LLM 调用 ----------
# 最终送入 LLM 的知识片段数
RAG_TOP_K=6
# 粗筛候选池规模（向量+BM25 经 RRF 融合后、Reranker 精排前）
RAG_CANDIDATE_K=20
# BM25 单路召回上限
RAG_BM25_TOP_K=20
# RRF 融合常数 k（越大越平滑，常规取 60~100）
RAG_RRF_K=60
# Reranker 精排开关；未安装 sentence-transformers 时自动回退 RRF 融合排序
RAG_RERANKER_ENABLED=true
# Reranker 模型（sentence-transformers CrossEncoder，安装见 README.md「API Key / 模型配置方式」）
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 向量相似度阈值（余弦，低于该值视为无关，走 BM25 路或兜底）
RAG_SIMILARITY_THRESHOLD=0.55
# 送入 LLM 的上下文 token 上限与请求超时
CONTEXT_MAX_TOKENS=6000
LLM_TIMEOUT_SECONDS=60
LLM_FIRST_TOKEN_TIMEOUT=30

# ---------- 002 知识库：上传 / 切分 / 向量化 ----------
# 单文件上传大小上限（MB）
MAX_UPLOAD_SIZE_MB=20
# 切分兜底参数（无标题/超长章节固定长度切分）
CHUNK_SIZE=500
CHUNK_OVERLAP=80
# 后台解析超时守卫（秒，超过视为失败）
PARSE_TIMEOUT_SECONDS=600
# 向量化分批大小与失败重试（瞬时网络超时兜底）
EMBEDDING_BATCH_SIZE=16
EMBEDDING_RETRY_TIMES=2
EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
# 原始文件存储目录（生产可换对象存储）
UPLOAD_DIR=./storage/uploaded

# ---------- 004 会话与消息分页 ----------
SESSION_PAGE_SIZE=20
MESSAGE_PAGE_SIZE=20
# 消息分页单页上限（防超大页拉取）
MESSAGE_PAGE_SIZE_MAX=100
DEFAULT_SESSION_TITLE=新会话
SESSION_TITLE_SUMMARY_LEN=20
# 问答历史上下文轮数（送入 LLM 的历史消息对数）
CONTEXT_TURNS=6

# ---------- 005 用户反馈 ----------
# 反馈文字长度上限（字）
FEEDBACK_MAX_LENGTH=200

# ---------- Celery / Redis（002 后台任务 · 已废弃，留作未来扩展） ----------
# 002 后台异步任务当前改用 FastAPI `BackgroundTasks` 进程内执行（免 Redis/Celery，见
# specs/002-knowledge-base/research.md §1）。以下配置项因此**不再必需**；仅当未来扩展回
# Celery + Redis（跨进程 worker）时再启用，同时需另装 Redis。
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# 测试置 true（任务同步执行，免 Redis）；生产留空/删掉（由 worker 异步消费）
# CELERY_TASK_ALWAYS_EAGER=true

# ---------- 006 意图识别模型 ----------
# 小模型层：独立厂商/端点配置（不复用 DEEPSEEK_* 凭据，可指向第三方 OpenAI 兼容端点）
# SMALL_MODEL_NAME=Qwen/Qwen3-8B
# SMALL_MODEL_API_KEY=your-third-party-api-key
# SMALL_MODEL_BASE_URL=https://api.your-endpoint.com/v1
# 三项均留空时小模型层短路，直接流转大模型兜底
# 大模型兜底层：复用上方 LLM_MODEL / LLM_BASE_URL / DEEPSEEK_API_KEY
# 意图识别总开关（false 时识别结果恒为「未识别」，规则层也不生效）
INTENT_ENABLED=true
# 高/低双阈值（≥高直接输出；中段澄清重判；<低流转大模型兜底）
INTENT_HIGH_THRESHOLD=0.9
INTENT_LOW_THRESHOLD=0.6
# 中段置信度澄清后的重判次数
INTENT_CLARIFY_RETRY=1
# 反向校准（负样本拦截）开关
INTENT_REVERSE_CALIBRATE=true
# LLM 自检（默认关闭，保留占位）
# INTENT_MODEL_SELF_CHECK=false
# 规则层配置（关键词 / 句式模板 / 负样本）yaml 路径
# INTENT_KEYWORDS_PATH=./config/intent_keywords.yaml
# INTENT_PATTERNS_PATH=./config/intent_patterns.yaml
# INTENT_NEGATIVE_SAMPLES_PATH=./config/intent_negative_samples.yaml
# 闲聊 / 投诉模板话术（可自定义文案）
# INTENT_SMALL_TALK_REPLY=您好，很高兴为您服务！
# INTENT_COMPLAINT_REPLY=非常抱歉，已为您记录并转交专属客服。
# 意图模型调用参数
INTENT_LLM_TIMEOUT_SECONDS=30
INTENT_LLM_MAX_RETRIES=2

# ---------- 008 链路埋点 ----------
# 采集/落库/打印总开关（false 时零采集零打印零落库）
TRACE_ENABLED=true
# 后台批量落库开关（测试置 false；生产保持 true）
TRACE_FLUSH_ENABLED=true
# 周期 flush 间隔（秒）与缓冲阈值（条，达到即提前 flush）
TRACE_FLUSH_INTERVAL_SECONDS=10
TRACE_BUFFER_SIZE=200
# 控制台打印可读完整链路块
TRACE_CONSOLE_LOG=true
# trace 保留期（天）；<=0 表示不清理
TRACE_RETENTION_DAYS=7

# ---------- 日志 ----------
LOG_LEVEL=INFO
