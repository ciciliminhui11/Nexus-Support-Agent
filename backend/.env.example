# ===================== 环境变量模板 =====================
# 复制本文件为 `.env` 并填写真实值。真实密钥禁止提交仓库。
# 各配置项说明见 app/config.py 与 specs/*/contracts/* 的「配置契约」章节。

# ---------- 数据库（必填） ----------
# MySQL 8.0，连接串格式：mysql+pymysql://<user>:<password>@<host>:<port>/<db>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/nexus_support?charset=utf8mb4

# ---------- 鉴权（JWT 必填） ----------
# JWT 签名密钥，生产环境必填且 ≥32 字节随机串
JWT_SECRET=please-change-me-to-a-random-secret-at-least-32-bytes
JWT_EXPIRE_HOURS=24
MIN_PASSWORD_LENGTH=8
DAILY_QUOTA_LIMIT=100
# 预置管理员账号标识（启动时置 admin 角色）
ADMIN_ACCOUNT=admin
# 仅开发预置用默认密码，生产必须修改
ADMIN_PASSWORD=admin123456

# ---------- LLM / Embedding ----------
# 向量库本地目录
CHROMA_DIR=./chroma_data
# 对话 LLM 后端：deepseek（OpenAI 兼容 API，默认）| ollama（本地）
LLM_BACKEND=deepseek
# DeepSeek 官方 OpenAI 兼容 API（001 对话 LLM；与 006 共用 KEY，模型分开）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
# embedding 后端：local（本地 sentence-transformers）或 ollama（经 Ollama 提供 bge-m3）
EMBEDDING_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
# 仅 LLM_BACKEND=ollama 时生效（本地对话模型）
OLLAMA_CHAT_MODEL=qwen2

# ---------- 001 RAG 混合检索 / 精排 ----------
# 最终送入 LLM 的知识片段数
RAG_TOP_K=6
# 粗筛候选池规模（向量+BM25 经 RRF 融合后、Reranker 精排前）
RAG_CANDIDATE_K=20
# BM25 单路召回上限
RAG_BM25_TOP_K=20
# RRF 融合常数 k（越大越平滑，常规取 60~100）
RAG_RRF_K=60
# Reranker 精排开关；未安装 sentence-transformers 时自动回退 RRF 融合排序
RAG_RERANKER_ENABLED=true
# Reranker 模型（sentence-transformers CrossEncoder，安装见 docs/重难点总结.md 第五部分 §5）
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 向量相似度阈值（余弦，低于该值视为无关，走 BM25 路或兜底）
RAG_SIMILARITY_THRESHOLD=0.55

# ---------- Celery / Redis（002 后台任务 · 已废弃，留作未来扩展） ----------
# 002 后台异步任务当前改用 FastAPI `BackgroundTasks` 进程内执行（免 Redis/Celery，见
# specs/002-knowledge-base/research.md §1）。以下配置项因此**不再必需**；仅当未来扩展回
# Celery + Redis（跨进程 worker）时再启用，同时需安装 Redis（见 docs/安装教程.md §2）。
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# 测试置 true（任务同步执行，免 Redis）；生产留空/删掉（由 worker 异步消费）
# CELERY_TASK_ALWAYS_EAGER=true

# ---------- 006 意图识别模型（复用上方 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL） ----------
# 006 意图识别专用模型（001 对话用 DEEPSEEK_CHAT_MODEL）
DEEPSEEK_SMALL_MODEL=DeepSeek-R1-0528-Qwen3-8B
DEEPSEEK_LARGE_MODEL=

# ---------- 日志 ----------
LOG_LEVEL=INFO
